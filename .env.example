# Copy to .env and fill in.
#
# The only credential needed to render. Script generation goes through the
# Claude Code CLI, which is already authenticated with your subscription --
# there is deliberately no ANTHROPIC_API_KEY here. Publishing needs two more,
# further down, and only if you want the pipeline to post for you.

# Classic personal access token, NO scopes required for public repos.
# Create at: https://github.com/settings/tokens
# Without it you get 10 search requests/min and 60 core requests/hour, which
# is not enough for a single pipeline run.
GITHUB_TOKEN=ghp_replace_me

# --- Instagram publishing (optional) ---
# Only needed for `--post` and `--publish`. Everything else runs without them.
# Full setup is docs/instagram-api-setup.md. The short version:
#   1. Business account, linked to a Facebook Page.
#   2. A Meta app in DEVELOPMENT mode, your account added as an Instagram
#      tester. No App Review: that is only for posting to accounts you do not
#      own, and Standard Access covers accounts holding a role on your own app.
#   3. Scopes instagram_business_basic + instagram_business_content_publish.
#   4. Exchange the short-lived token for a long-lived one, and paste it below.
#
# Your Instagram professional account ID (a 17-digit number, not the handle).
# IG_USER_ID=

# The SEED token only. `--refresh-token` moves it into data/ig_token.json and
# every refresh after that updates the file, not this line. Long-lived tokens
# die after 60 days without a refresh and an expired one cannot be renewed, so
# keep the daily --snapshot job installed: it refreshes when the token is
# inside IG_REFRESH_MARGIN_DAYS of expiry.
# IG_ACCESS_TOKEN=

# graph.instagram.com is the Instagram Login path. Switch to
# https://graph.facebook.com only if you set the app up with Facebook Login
# instead, which needs a different permission set.
# IG_GRAPH_HOST=https://graph.instagram.com
# IG_API_VERSION=v23.0

# How long to wait for Meta to transcode before giving up. The container stays
# valid for 24 hours, so a timeout is recoverable with another --publish.
# IG_PUBLISH_TIMEOUT_S=300
# IG_POLL_INTERVAL_S=8
# IG_UPLOAD_TIMEOUT_S=600
# IG_REFRESH_MARGIN_DAYS=15

# --- YouTube authorisation (optional, one run per channel) ---
# Read only by scripts/youtube_authorise.py, which turns a browser consent into
# a channel registered with the gateway. Nothing else reads them: the gateway
# keeps its own copy in youtube_credentials, because it is the thing that
# publishes and the Mac may well be asleep when a slot comes due.
#
# Full setup is docs/youtube-api-setup.md. The short version:
#   1. A Brand Account channel on a Google account that is not your primary.
#   2. A Cloud project with YouTube Data API v3 and YouTube Analytics API on.
#   3. Consent screen External and published to PRODUCTION. Left in Testing it
#      hands out refresh tokens that expire after exactly 7 days, so an
#      unattended publisher works and then stops every Monday.
#   4. An OAuth client of type Desktop app. Paste its two values below.
#   5. The audit form, which is a different process from OAuth verification and
#      is the one that decides whether uploads are locked private forever.
#
# The console shows the secret once, at creation. Google does not treat a
# desktop client secret as confidential, since using it also needs an
# authorisation code from your browser over a loopback redirect, but it is
# still not something to paste around.
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=

# --- Talking to the DM gateway from the pipeline (optional) ---
# Where the gateway is reachable, and the bearer token it expects on /api/*.
# Both empty is the normal state if you do not run the gateway: the pipeline
# then skips cover hosting and post registration entirely.
#
# When set, `--post` and `--publish` upload cover.png to get a public URL Meta
# can fetch, and register the published post so its comments are watched. Both
# are best effort and never fail a publish (pipeline/gateway.py).
# GATEWAY_URL=https://gate.example.com
# GATEWAY_TOKEN=
# The word the caption tells people to comment. Also added to the caption
# automatically, above the hashtags, but only when GATEWAY_URL is set, because
# otherwise nothing is listening for it.
# GATEWAY_KEYWORD=send

# --- Running the DM gateway itself (optional, local development only) ---
# The gateway is a separate service (see gateway/README.md). In the cluster it
# gets these from an ExternalSecret; locally it reads them from this file. The
# GATEWAY_ prefix is what keeps the two config objects from colliding, since
# the gateway deliberately does not import config.py.
#
# Without all three set, the service refuses to start rather than serving an
# unsigned webhook route and a bearer route with an empty token.
# GATEWAY_APP_SECRET=      # Meta app secret; signs every webhook delivery
# GATEWAY_VERIFY_TOKEN=    # any random string, must match the Meta dashboard
# GATEWAY_API_TOKEN=       # what the pipeline presents on /api/*

# Where Meta and the browser reach the service. Meta fetches the cover image
# from this host, so localhost only works if a tunnel points at it.
# GATEWAY_PUBLIC_BASE_URL=http://localhost:8000
# GATEWAY_DB_PATH=gateway/dev.sqlite3
# GATEWAY_COVERS_DIR=gateway/covers

# One sweep a minute is far inside Meta's 750 private replies per hour, and the
# reply window is 7 days, so downtime costs nothing.
# GATEWAY_POLL_INTERVAL_S=60
# GATEWAY_DEFAULT_KEYWORD=send
# Reminders asking for the follow, before the conversation goes quiet.
# GATEWAY_MAX_NUDGES=3

# --- Insights ---
# Reads how the published Reels are doing and stores one reading per post per
# day, which is what the Posts page draws. On by default, unlike the scheduler:
# this only reads, so it creates nothing, publishes nothing and messages nobody.
# GATEWAY_INSIGHTS_ENABLED=true
# Meta updates these roughly daily, so anything faster spends Graph calls
# redrawing the same numbers. Four sweeps a day is plenty to catch the change.
# GATEWAY_INSIGHTS_INTERVAL_S=21600
# Past this a Reel has stopped moving, and re-reading everything ever posted
# would grow a Graph call a day forever.
# GATEWAY_INSIGHTS_MAX_AGE_DAYS=30

# --- The scheduled queue (optional) ---
# Off by default. Publishing to the feed is a bigger power than answering
# comments, so the service does not gain it just by being upgraded.
# GATEWAY_SCHEDULER_ENABLED=false
#
# When the queue drains. One slot per line, so this drops into a ConfigMap as a
# block string. Only the time is required; `days` is ISO weekdays, 1 for Monday,
# and leaving it out means every day. A line that does not parse fails the boot
# rather than silently disappearing from the schedule.
#
#   GATEWAY_SLOTS="18:00 Europe/Oslo jitter=15
#   08:30 Europe/Oslo jitter=20 days=6,7"
#
# GATEWAY_SLOTS=
# Only needed with more than one account registered.
# GATEWAY_SLOTS_ACCOUNT=
#
# Each firing moves by up to this many minutes either way, to the second, and
# never onto :00, :15, :30 or :45. A column of timestamps on a fifteen minute
# grid is the cheapest automation tell there is.
# The offset is derived from the slot and the date, so it is stable across
# restarts; see gateway/schedule.py for why that matters.
# GATEWAY_DEFAULT_JITTER_MINUTES=15
# GATEWAY_DEFAULT_TIMEZONE=UTC
#
# How late a missed slot may still fire. Past this the day is written off,
# because a pod that was down all night should not post at breakfast.
# GATEWAY_SCHEDULER_GRACE_MINUTES=90
# GATEWAY_SCHEDULER_INTERVAL_S=60
# GATEWAY_MAX_PUBLISH_ATTEMPTS=3

# The admin UI at /admin. Off by default, and it refuses to start switched on
# with no authentication: this service is publicly reachable because Meta
# fetches media from it, so there is no network boundary to hide behind.
# GATEWAY_ADMIN_ENABLED=false
# The panel's own password. At least 24 characters; `openssl rand -hex 24`.
# GATEWAY_ADMIN_TOKEN=
# Set this instead when forward-auth (Authentik at Traefik) already protects
# /admin. An explicit statement, never inferred from a header, because every
# header is attacker-settable on a service this exposed.
# GATEWAY_ADMIN_TRUST_PROXY_AUTH=false
# GATEWAY_ADMIN_SESSION_HOURS=12

# --- Everything below is optional; these are the defaults ---

# Claude model alias used for script generation (opus | sonnet | haiku).
# CLAUDE_MODEL=opus

# Reasoning effort for script generation (low | medium | high | xhigh | max).
# CLAUDE_EFFORT=high

# Let Claude Code research the repo on the web before writing the script.
# Set to false for a faster, cheaper, README-only script.
# CLAUDE_RESEARCH=true

# On-screen hook length. One source for both the prompt and the validator, so
# they cannot disagree. Past ~60 it wraps to a third line and stops reading as
# a headline.
# MAX_HOOK_CHARS=60

# edge-tts voice. Alternatives worth trying:
#   en-US-BrianMultilingualNeural   (warmer)
#   en-US-AndrewMultilingualNeural  (default, confident//documentary)
#   en-GB-RyanNeural                (British)
# Only used when TTS_BACKEND=edge.
# TTS_VOICE=en-US-AndrewMultilingualNeural
# TTS_RATE=+0%

# faster-whisper model: tiny.en | base.en | small.en | medium.en
# small.en is the sweet spot for 45s of clean TTS audio.
# WHISPER_MODEL=small.en

# Days before a repo may be featured again.
# REPO_COOLDOWN_DAYS=30
# Started by `main.py --posted <owner/repo>`, not by the render.

# --- Voice ---
# "chatterbox" (default) = a clone of my own voice, built from a 25 second
#   recording. Local, MIT weights. Both the venv (~3 GB) and the reference
#   recording are gitignored, so a fresh checkout must set this up before the
#   default backend works: see tools/chatterbox/README.md. Until then, use
#   TTS_BACKEND=kokoro.
# "kokoro" = fully local, Apache-2.0, 54 voices, and NOT the voice
#   you have heard in every AI video. Needs a one-time ~350 MB model download:
#     curl -L -o models/kokoro-v1.0.onnx https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.0/kokoro-v1.0.onnx
#     curl -L -o models/voices-v1.0.bin  https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.0/voices-v1.0.bin
# "edge" = Microsoft Edge voices. Free and keyless, but a network call, and its
#   only natural English voices are the ubiquitous Andrew/Brian/Ava/Emma.
# TTS_BACKEND=chatterbox

# Kokoro voices. US male: am_michael am_adam am_echo am_eric am_fenrir am_liam
#   am_onyx am_puck | UK male: bm_george bm_lewis bm_daniel bm_fable
#   (female: af_* / bf_*; run `--preview-voice` to audition one)
# KOKORO_VOICE=am_michael
# Only applies to the kokoro backend; the clone's pace comes from the reference
# recording instead. The live .env runs 1.28.
# KOKORO_SPEED=1.15
